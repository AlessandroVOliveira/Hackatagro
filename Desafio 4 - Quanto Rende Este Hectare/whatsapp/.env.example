# Copiado para .env por `python configurar.py iniciar`, que troca os valores <...> por segredos aleatórios.
# O .env não vai para o git.

# ---- Evolution API
SERVER_URL=http://localhost:8080
AUTHENTICATION_API_KEY=<gerado>
LANGUAGE=pt-BR
LOG_LEVEL=ERROR,WARN,INFO
DEL_INSTANCE=false
CONFIG_SESSION_PHONE_CLIENT=Conta do Talhao
CONFIG_SESSION_PHONE_NAME=Chrome

DATABASE_PROVIDER=postgresql
POSTGRES_PASSWORD=<gerado>
DATABASE_CONNECTION_URI=postgresql://evolution:${POSTGRES_PASSWORD}@postgres:5432/evolution?schema=evolution_api
DATABASE_CONNECTION_CLIENT_NAME=conta_talhao
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_HISTORIC=false
DATABASE_SAVE_DATA_LABELS=false

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=conta_talhao
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# ---- Conta do Talhão (lidos pelo app em Python)
EVOLUTION_URL=http://localhost:8080
EVOLUTION_APIKEY=${AUTHENTICATION_API_KEY}
EVOLUTION_INSTANCIA=conta-talhao
WHATSAPP_WEBHOOK_TOKEN=<gerado>
# Endereço em que a Evolution (dentro do Docker) enxerga o app
WHATSAPP_WEBHOOK_URL=http://host.docker.internal:8600/api/whatsapp/webhook
